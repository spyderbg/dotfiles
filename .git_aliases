################################################################################
# Git aliases 
################################################################################

# Git common aliases
alias gg='git status'
alias ggs='git diff --shortstat'

# Git checkout aliases
unalias gcb 2> /dev/null
alias gcob='git checkout -b'
unalias gcB 2> /dev/null
alias gcoB='git checkout -B'
unalias gcd 2> /dev/null
alias gcod='git checkout $(git_develop_branch)'
unalias gcm 2> /dev/null
alias gcom='git checkout $(git_main_branch)'

# Git commit aliases
alias gc='git commit'
alias gcm='git commit --message'
alias gca='git commit --amend'
alias gccode='git commit -am "Code refactoring" && git push'

# Git rebase aliases
alias grbim='git rebase --interactive $(git_main_branch)'

# Git log aliases
alias glp='git log -p -1'
alias glone='git log --oneline'
alias gl='clear && git graph --since=yesterday'
alias glt='clear && git log --since=yesterday'
alias glgt='clear && git lola -25'

# Git push aliases
alias gpc='git push --set-upstream origin $(git_current_branch)'

# Git stash aliases
alias gst='git stash'
unalias gstp 2> /dev/null
alias gstp='git stash push -m'
unalias gsta 2> /dev/null
alias gsta='git stash apply'
alias gstl='git stash list'
alias gsta0='git stash apply stash@{0}'
alias gsta1='git stash apply stash@{1}'
alias gsta2='git stash apply stash@{2}'
alias gsta3='git stash apply stash@{3}'
alias gsta4='git stash apply stash@{4}'
alias gsta5='git stash apply stash@{5}'
alias gstd0='git stash drop stash@{0}'
alias gstd1='git stash drop stash@{1}'
alias gstd2='git stash drop stash@{2}'
alias gstd3='git stash drop stash@{3}'
alias gstd4='git stash drop stash@{4}'
alias gstd5='git stash drop stash@{5}'

# Git special aliases
alias grelease='git checkout main && git pull && git merge dev && git push && git checkout -'
alias gdelete='git push origin -d'

